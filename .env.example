# SupportFlow AI — example environment variables
# Copy via: scripts/generate_dev_env.sh  (preferred; writes .env with random secrets)
# Or copy this file to `.env` and replace placeholders yourself.
# Never commit real `.env` files or secrets.
# Values below are non-working placeholders, not default credentials.

# --- Application ---
APP_ENV=development
APP_NAME=SupportFlow AI
# INFERENCE_FIXTURE defaults to false and must stay unset/false in development
# and production (startup fails if true). Only test/acceptance may enable it.
# Request headers, query params, and message text never enable fixtures.
# Inside the API container uvicorn binds 0.0.0.0:8000.
# Compose publishes the API only on the host loopback interface: 127.0.0.1:8000
#
# Next.js frontend uses its own server-only env file:
#   frontend/.env.example → frontend/.env.local
#   FASTAPI_BASE_URL=http://127.0.0.1:8000
# Do not put FASTAPI_BASE_URL in a NEXT_PUBLIC_ variable.

# --- PostgreSQL (Compose service name: db) ---
POSTGRES_USER=REPLACE_WITH_LOCAL_DB_USER
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
POSTGRES_DB=supportflow
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://REPLACE_WITH_LOCAL_DB_USER:REPLACE_WITH_LOCAL_DB_PASSWORD@db:5432/supportflow
# Isolated DB `supportflow_test` is created on first Postgres init for pytest.
# PostgreSQL is intentionally NOT published to the host.

# --- Ollama (Phase 2.1 — local inference on the Mac host) ---
# Selected model: qwen3:1.7b (Q4_K_M-class, ~1.4GB, Apache-2.0 on Ollama library).
# Pull on the host: ollama pull qwen3:1.7b
# Host processes (eval script): http://127.0.0.1:11434
# API container (Compose default below): http://host.docker.internal:11434
# Do NOT expose Ollama on a public interface.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_INFERENCE_TIMEOUT_SECONDS=60
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=128
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_TEMPERATURE=0
# AI availability is NOT required for GET /ready.

# Container-to-host Ollama networking:
# Inside Docker, localhost points at the container. On Docker Desktop for Mac,
# use host.docker.internal to reach Ollama on the host.

# --- Human approval / demo safety ---
REQUIRE_HUMAN_APPROVAL=true
CLAIM_LIVE_COURIER_TRACKING=false
